target/
node_modules/
packages/*/node_modules/
examples/**/dist/
# Vault. Delivery scratch stays out of the repo, but memory is durable and
# must be committed — `ψ/memory/` held 18 learnings with 0 tracked, so every
# lesson lived on one machine's disk and nowhere else.
#
# `ψ/` (a bare directory exclude) previously sat below these and made the
# `!` lines inert: git does not descend into an excluded directory, so a
# child can never be re-included. `ψ/teams/` only survived because those
# files predate the rule and gitignore does not affect tracked files.
ψ/*
!ψ/teams/
!ψ/memory/

# codex coder runtime homes (worktree-local CODEX_HOME)
.codex/
.maw-engine/

# nova builder worktrees
agents/

# >>> maw ephemeral markers (managed by maw-rs) >>>
.maw/delivery.json
.maw/l1-review-request.json
.maw/delivery-notified
.maw/l1-oracle
.maw/l1-pane
.maw/pane-id
.maw/auto-done-pinged
.maw/phase.json
.maw/req-line
.maw/l2-meta*.json
.maw/l2-observer*.json
.maw/l2-transition*.json
.maw/delivery-issue*.json*
.maw/pr-*-body.md
# <<< maw ephemeral markers <<<
